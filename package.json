{
  "name": "boatify",
  "version": "0.38.0",
  "description": "No Paddle — your oar is lost, so sail by the wind from point A to point B. An Android sailing game.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs web",
    "serve:dist": "node scripts/serve.mjs dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "smoke": "node scripts/build.mjs && node scripts/smoke.cjs",
    "store-art": "node scripts/build.mjs && node scripts/store-art.cjs",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=18"
  }
}
